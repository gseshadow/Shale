					<String fx:value="app-toolbar-button-primary" />
				</styleClass>
			</Button>

			<TextField fx:id="caseUpdatesSearchField"
				promptText="Search updates..." />

			<ScrollPane fx:id="caseUpdatesScrollPane"
				fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
				styleClass="transparent-scroll">
				<VBox fx:id="caseUpdatesFeedBox" spacing="8.0" styleClass="secondary-panel">
					<padding>
						<Insets top="2" right="2" bottom="2" left="2" />
					</padding>
				</VBox>
			</ScrollPane>
		</VBox>
	</right>

</BorderPane>
