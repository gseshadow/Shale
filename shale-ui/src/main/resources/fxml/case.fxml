<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="caseRootPane"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="com.shale.ui.controller.CaseController"
	styleClass="app-shell">

	<!-- TOP: Header / Command Bar (slightly tighter) -->
	<top>
		<VBox spacing="4.0" BorderPane.alignment="CENTER">
			<padding>
				<Insets top="8" right="12" bottom="6" left="12" />
			</padding>

			<!-- Main header row: case title + status -->
			<HBox spacing="8.0" alignment="CENTER_LEFT">
				<Label fx:id="caseTitleLabel" text="Case (Placeholder)"
					style="-fx-font-size: 18px; -fx-font-weight: bold;" />
				<StackPane fx:id="statusHost" />

				<Region HBox.hgrow="ALWAYS" />
			</HBox>

			<!-- Secondary row: compact metadata -->
			<HBox spacing="8.0" alignment="CENTER_LEFT">
				<Label fx:id="caseMetadataLabel" text="Case #—"
					style="-fx-opacity: 0.8;" />
				<Label text="•" style="-fx-opacity: 0.55;" />
				<StackPane fx:id="assignedUserHost" />
				<Label text="•" style="-fx-opacity: 0.55;" />
				<Label fx:id="lastUpdatedLabel" text="Last updated: —"
					style="-fx-opacity: 0.7;" />
			</HBox>

			<StackPane fx:id="statusTimelineHost" maxWidth="1.7976931348623157E308" minHeight="48" />
		</VBox>
	</top>


	<!-- CENTER: Content area (we switch panes by showing/hiding) -->
	<center>
		<VBox spacing="8.0" BorderPane.alignment="CENTER">
			<padding>
				<Insets top="10" right="12" bottom="12" left="12" />
			</padding>
			<HBox fx:id="sectionTabsBar" spacing="8.0" alignment="CENTER_LEFT" />
			<StackPane fx:id="contentHost" VBox.vgrow="ALWAYS">

			<!-- OVERVIEW PANE -->
			<ScrollPane fx:id="overviewScrollPane" fitToWidth="true"
				hbarPolicy="NEVER" styleClass="surface-scroll">
				<VBox fx:id="overviewPane" spacing="10" maxWidth="980">
					<styleClass>
						<String fx:value="shale-surface" />
						<String fx:value="shale-surface-content" />
						<String fx:value="case-overview-surface" />
					</styleClass>
					<padding>
						<Insets top="12" right="12" bottom="12" left="12" />
					</padding>
					<HBox alignment="CENTER_LEFT" spacing="8">
						<Label fx:id="contentTitleLabel" text="Case Overview"
							style="-fx-font-size: 16px; -fx-font-weight: bold;" />
						<Region HBox.hgrow="ALWAYS" />
						<Button fx:id="deleteCaseButton" id="caseOverviewDeleteCaseButton"
							text="Delete Case" visible="false" managed="false">
							<styleClass>
								<String fx:value="app-toolbar-button" />
								<String fx:value="app-toolbar-button-danger" />
								<String fx:value="shale-button-destructive" />
								<String fx:value="shale-button-toolbar" />
							</styleClass>
						</Button>
						<Button fx:id="editButton" text="Edit" visible="false" managed="false">
							<styleClass>
								<String fx:value="app-toolbar-button" />
								<String fx:value="app-toolbar-button-neutral" />
								<String fx:value="shale-button-secondary" />
								<String fx:value="shale-button-toolbar" />
							</styleClass>
						</Button>
						<MenuButton fx:id="generateSummaryMenuButton"
							text="Generate Summary">
							<styleClass>
								<String fx:value="app-toolbar-button" />
								<String fx:value="app-toolbar-button-primary" />
								<String fx:value="shale-button-primary" />
								<String fx:value="shale-button-toolbar" />
							</styleClass>
							<items>
								<MenuItem fx:id="generateSummaryHtmlMenuItem"
									text="Preview HTML">
									<styleClass>
										<String fx:value="app-toolbar-menu-item" />
									</styleClass>
								</MenuItem>
								<MenuItem fx:id="generateSummaryPdfMenuItem"
									text="Export PDF">
									<styleClass>
										<String fx:value="app-toolbar-menu-item" />
									</styleClass>
								</MenuItem>
							</items>
						</MenuButton>
						<Label fx:id="summaryGenerationStatusLabel" text=""
							visible="false" managed="false" style="-fx-opacity: 0.75;" />
						<Button fx:id="saveButton" text="Save" visible="false"
							managed="false">
							<styleClass>
								<String fx:value="app-toolbar-button" />
								<String fx:value="app-toolbar-button-primary" />
								<String fx:value="shale-button-primary" />
								<String fx:value="shale-button-toolbar" />
							</styleClass>
						</Button>
						<Button fx:id="cancelButton" text="Cancel" visible="false"
							managed="false">
							<styleClass>
								<String fx:value="app-toolbar-button" />
								<String fx:value="app-toolbar-button-neutral" />
								<String fx:value="shale-button-secondary" />
								<String fx:value="shale-button-toolbar" />
							</styleClass>
						</Button>
					</HBox>

					<HBox spacing="8" alignment="CENTER_LEFT">
						<Label fx:id="errorLabel" textFill="#b42318" wrapText="true"
							visible="false" managed="false" />
					</HBox>

					<HBox fx:id="remoteUpdateBanner" spacing="8"
						alignment="CENTER_LEFT" visible="false" managed="false">
						<Label text="This case was updated elsewhere."
							style="-fx-text-fill: #b42318;" />
						<Button fx:id="reloadRemoteButton" text="Reload" />
					</HBox>


					<VBox spacing="16" maxWidth="1.7976931348623157E308" styleClass="case-overview-list">
						<VBox spacing="5">
							<styleClass>
								<String fx:value="shale-surface-section" />
								<String fx:value="case-overview-section" />
								<String fx:value="case-overview-section-region" />
								<String fx:value="case-overview-section-region-case-details" />
							</styleClass>
							<HBox spacing="8" alignment="CENTER_LEFT" styleClass="case-overview-section-header">
								<Region>
									<styleClass>
										<String fx:value="shale-indicator-practice-area" />
										<String fx:value="case-overview-section-accent" />
										<String fx:value="case-overview-section-accent-case-details" />
									</styleClass>
								</Region>
								<Label text="▣" styleClass="case-overview-section-icon" />
								<Label text="Case Details" styleClass="case-overview-section-title" />
								<Region HBox.hgrow="ALWAYS" styleClass="case-overview-section-line" />
							</HBox>
							<GridPane hgap="14" vgap="0" styleClass="case-overview-rows">
								<columnConstraints>
									<ColumnConstraints minWidth="150" prefWidth="170" />
									<ColumnConstraints hgrow="ALWAYS" fillWidth="true" />
									<ColumnConstraints minWidth="36" prefWidth="36" maxWidth="36" halignment="RIGHT" />
								</columnConstraints>
								<Label text="Case name" styleClass="case-overview-row-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
								<Label fx:id="ovCaseNameValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="0" GridPane.columnIndex="1" />
								<TextField fx:id="ovCaseNameEditor" visible="false" managed="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />
								<Button fx:id="editCaseNameButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="0" GridPane.columnIndex="2" />

								<Label text="Case number" styleClass="case-overview-row-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
								<Label fx:id="ovCaseNumberValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="1" GridPane.columnIndex="1" />
								<TextField fx:id="ovCaseNumberEditor" visible="false" managed="false" GridPane.rowIndex="1" GridPane.columnIndex="1" />
								<Button fx:id="editCaseNumberButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="1" GridPane.columnIndex="2" />

								<Label text="Practice area" styleClass="case-overview-row-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
								<StackPane fx:id="ovPracticeAreaHost" styleClass="case-overview-row-value-host" GridPane.rowIndex="2" GridPane.columnIndex="1" />
								<Button fx:id="changePracticeAreaButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="2" GridPane.columnIndex="2" />

								<Label text="Case status" styleClass="case-overview-row-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
								<StackPane fx:id="ovCaseStatusHost" styleClass="case-overview-row-value-host" GridPane.rowIndex="3" GridPane.columnIndex="1" />
								<Button fx:id="changeStatusButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="3" GridPane.columnIndex="2" />

								<Label text="Date of injury" styleClass="case-overview-row-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
								<Label fx:id="ovIncidentDateValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="4" GridPane.columnIndex="1" />
								<DatePicker fx:id="ovIncidentDateEditor" visible="false" managed="false" GridPane.rowIndex="4" GridPane.columnIndex="1" />
								<Button fx:id="editIncidentDateButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="4" GridPane.columnIndex="2" />

								<Label text="Date of medical negligence" styleClass="case-overview-row-label" GridPane.rowIndex="5" GridPane.columnIndex="0" />
								<Label fx:id="ovDateOfMedicalNegligenceValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="5" GridPane.columnIndex="1" />
								<DatePicker fx:id="ovDateOfMedicalNegligenceEditor" visible="false" managed="false" GridPane.rowIndex="5" GridPane.columnIndex="1" />
								<Button fx:id="editDateOfMedicalNegligenceButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="5" GridPane.columnIndex="2" />

								<Label text="Intake date" styleClass="case-overview-row-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
								<Label fx:id="ovIntakeDateValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="6" GridPane.columnIndex="1" />

								<Label text="Statute of limitations" styleClass="case-overview-row-label" GridPane.rowIndex="7" GridPane.columnIndex="0" />
								<Label fx:id="ovSolDateValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="7" GridPane.columnIndex="1" />
								<DatePicker fx:id="ovSolDateEditor" visible="false" managed="false" GridPane.rowIndex="7" GridPane.columnIndex="1" />
								<Button fx:id="editSolDateButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="7" GridPane.columnIndex="2" />

								<Label text="Tort notice deadline" styleClass="case-overview-row-label" GridPane.rowIndex="8" GridPane.columnIndex="0" />
								<Label fx:id="ovTortNoticeDeadlineValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="8" GridPane.columnIndex="1" />
								<DatePicker fx:id="ovTortNoticeDeadlineEditor" visible="false" managed="false" GridPane.rowIndex="8" GridPane.columnIndex="1" />
								<Button fx:id="editTortNoticeDeadlineButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="8" GridPane.columnIndex="2" />

								<Label text="Responsible attorney" styleClass="case-overview-row-label" GridPane.rowIndex="9" GridPane.columnIndex="0" />
								<StackPane fx:id="ovResponsibleAttorneyHost" styleClass="case-overview-row-value-host" GridPane.rowIndex="9" GridPane.columnIndex="1" />
								<Button fx:id="changeResponsibleAttorneyButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="9" GridPane.columnIndex="2" />

								<Label text="Primary legal assistant" styleClass="case-overview-row-label" GridPane.rowIndex="10" GridPane.columnIndex="0" />
								<StackPane fx:id="ovPrimaryLegalAssistantHost" styleClass="case-overview-row-value-host" GridPane.rowIndex="10" GridPane.columnIndex="1" />

								<Label text="Description" styleClass="case-overview-row-label" GridPane.rowIndex="11" GridPane.columnIndex="0" />
								<Label fx:id="ovDescriptionValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="11" GridPane.columnIndex="1" />
								<TextArea fx:id="ovDescriptionEditor" visible="false" managed="false" wrapText="true" prefRowCount="4" GridPane.rowIndex="11" GridPane.columnIndex="1" />
								<Button fx:id="editDescriptionButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="11" GridPane.columnIndex="2" />
							</GridPane>
						</VBox>

						<VBox fx:id="ovPrimaryLinkSection" spacing="5">
							<styleClass>
								<String fx:value="shale-surface-section" />
								<String fx:value="case-overview-section" />
								<String fx:value="case-overview-section-region" />
								<String fx:value="case-overview-section-region-case-details" />
							</styleClass>
							<HBox spacing="8" alignment="CENTER_LEFT" styleClass="case-overview-section-header">
								<Region>
									<styleClass>
										<String fx:value="shale-indicator-practice-area" />
										<String fx:value="case-overview-section-accent" />
										<String fx:value="case-overview-section-accent-case-details" />
									</styleClass>
								</Region>
								<Label text="🔗" styleClass="case-overview-section-icon" />
								<Label text="Primary Link" styleClass="case-overview-section-title" />
								<Region HBox.hgrow="ALWAYS" styleClass="case-overview-section-line" />
							</HBox>
							<VBox fx:id="ovPrimaryLinkBox" spacing="6" />
							<Label fx:id="ovPrimaryLinkStatusLabel" text="Loading primary link…" wrapText="true" styleClass="case-overview-row-value" />
						</VBox>

						<VBox spacing="5">
							<styleClass>
								<String fx:value="shale-surface-section" />
								<String fx:value="case-overview-section" />
								<String fx:value="case-overview-section-region" />
								<String fx:value="case-overview-section-region-parties" />
							</styleClass>
							<HBox spacing="8" alignment="CENTER_LEFT" styleClass="case-overview-section-header">
								<Region>
									<styleClass>
										<String fx:value="shale-indicator-practice-area" />
										<String fx:value="case-overview-section-accent" />
										<String fx:value="case-overview-section-accent-parties" />
									</styleClass>
								</Region>
								<Label text="♟" styleClass="case-overview-section-icon" />
								<Label text="Parties" styleClass="case-overview-section-title" />
								<Region HBox.hgrow="ALWAYS" styleClass="case-overview-section-line" />
								<Button fx:id="editPartiesButton" text="✎" styleClass="case-overview-edit-button" />
							</HBox>
							<VBox fx:id="ovPartiesBox" spacing="0" styleClass="case-overview-party-list" />
						</VBox>

						<VBox spacing="5">
							<styleClass>
								<String fx:value="shale-surface-section" />
								<String fx:value="case-overview-section" />
								<String fx:value="case-overview-section-region" />
								<String fx:value="case-overview-section-region-practice-team" />
							</styleClass>
							<HBox spacing="8" alignment="CENTER_LEFT" styleClass="case-overview-section-header">
								<Region>
									<styleClass>
										<String fx:value="shale-indicator-practice-area" />
										<String fx:value="case-overview-section-accent" />
										<String fx:value="case-overview-section-accent-practice-team" />
									</styleClass>
								</Region>
								<Label text="▰" styleClass="case-overview-section-icon" />
								<Label text="Practice &amp; Team" styleClass="case-overview-section-title" />
								<Region HBox.hgrow="ALWAYS" styleClass="case-overview-section-line" />
							</HBox>
							<GridPane hgap="14" vgap="0" styleClass="case-overview-rows">
								<columnConstraints>
									<ColumnConstraints minWidth="150" prefWidth="170" />
									<ColumnConstraints hgrow="ALWAYS" fillWidth="true" />
									<ColumnConstraints minWidth="36" prefWidth="36" maxWidth="36" halignment="RIGHT" />
								</columnConstraints>
								<Label text="Team" styleClass="case-overview-row-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
								<FlowPane fx:id="teamFlow" hgap="8" vgap="6" prefWrapLength="520" maxWidth="1.7976931348623157E308" styleClass="case-overview-row-value-host" GridPane.rowIndex="0" GridPane.columnIndex="1" />
								<Button fx:id="btnEditTeam" text="✎" onAction="#onEditTeam" styleClass="case-overview-edit-button" GridPane.rowIndex="0" GridPane.columnIndex="2" />
							</GridPane>
						</VBox>
					</VBox>

				</VBox>
			</ScrollPane>

			<!-- DETAILS PANE -->
			<VBox fx:id="detailsSectionPane" spacing="8" visible="false"
				managed="false">
				<HBox alignment="CENTER_LEFT" spacing="8">
					<Label text="Details"
						style="-fx-font-size: 16px; -fx-font-weight: bold;" />
					<Region HBox.hgrow="ALWAYS" />
					<Button fx:id="detailsEditButton" text="Edit">
						<styleClass>
							<String fx:value="button" />
							<String fx:value="app-toolbar-button" />
							<String fx:value="app-toolbar-button-neutral" />
						</styleClass>
					</Button>
					<Button fx:id="detailsSaveButton" text="Save"
						visible="false" managed="false">
						<styleClass>
							<String fx:value="button" />
							<String fx:value="app-toolbar-button" />
							<String fx:value="app-toolbar-button-primary" />
						</styleClass>
					</Button>
					<Button fx:id="detailsCancelButton" text="Cancel"
						visible="false" managed="false">
						<styleClass>
							<String fx:value="button" />
							<String fx:value="app-toolbar-button" />
							<String fx:value="app-toolbar-button-neutral" />
						</styleClass>
					</Button>
				</HBox>
				<HBox spacing="12" fillHeight="true" VBox.vgrow="ALWAYS">
					<ScrollPane fx:id="detailsScrollPane" fitToWidth="true"
						hbarPolicy="NEVER" styleClass="surface-scroll"
						HBox.hgrow="ALWAYS">
						<VBox fx:id="detailsPane" spacing="10" maxWidth="980"
						styleClass="case-main-surface">
						<padding>
							<Insets top="12" right="12" bottom="12" left="12" />
						</padding>

						<HBox spacing="8" alignment="CENTER_LEFT">
							<Label fx:id="detailsErrorLabel" textFill="#b42318"
								wrapText="true" visible="false" managed="false" />
						</HBox>

					<VBox spacing="10" styleClass="secondary-panel">
						<Label text="Core"
							style="-fx-font-weight: bold; -fx-opacity: 0.9;" />
						<GridPane hgap="14" vgap="10"
							style="-fx-alignment: TOP_LEFT;">
							<columnConstraints>
								<ColumnConstraints minWidth="210"
									prefWidth="230" />
								<ColumnConstraints hgrow="ALWAYS"
									fillWidth="true" />
								<ColumnConstraints minWidth="100"
									prefWidth="110" maxWidth="110" halignment="RIGHT" />
							</columnConstraints>
							<Label text="Name:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="0" />
							<Label fx:id="detNameValue" text="—" GridPane.rowIndex="0"
								GridPane.columnIndex="1" />
							<TextField fx:id="detNameEditor"
								maxWidth="1.7976931348623157E308" visible="false"
								managed="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />

							<Label text="Case Number:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="1" />
							<Label fx:id="detCaseNumberValue" text="—"
								GridPane.rowIndex="1" GridPane.columnIndex="1" />
							<TextField fx:id="detCaseNumberEditor"
								maxWidth="1.7976931348623157E308" visible="false"
								managed="false" GridPane.rowIndex="1" GridPane.columnIndex="1" />

							<Label text="Status:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="2" />
							<Label fx:id="detCaseStatusValue" text="—"
								GridPane.rowIndex="2" GridPane.columnIndex="1" />
							<HBox spacing="8" alignment="CENTER_LEFT"
								GridPane.rowIndex="2" GridPane.columnIndex="1"
								GridPane.columnSpan="2" fx:id="detCaseStatusEditorRow"
								visible="false" managed="false">
								<StackPane fx:id="detCaseStatusHost" />
								<Region HBox.hgrow="ALWAYS" />
								<Button fx:id="detChangeStatusButton" text="Change" />
							</HBox>

							<Label text="Practice Area:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="3" />
							<Label fx:id="detPracticeAreaIdValue" text="—"
								GridPane.rowIndex="3" GridPane.columnIndex="1" />
							<HBox spacing="8" alignment="CENTER_LEFT"
								GridPane.rowIndex="3" GridPane.columnIndex="1"
								GridPane.columnSpan="2" fx:id="detPracticeAreaEditorRow"
								visible="false" managed="false">
								<StackPane fx:id="detPracticeAreaHost" />
								<Region HBox.hgrow="ALWAYS" />
								<Button fx:id="detChangePracticeAreaButton" text="Change" />
							</HBox>

							<Label text="Description:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="4" />
							<Label fx:id="detDescriptionValue" text="—" wrapText="true"
								visible="false" managed="false" GridPane.rowIndex="4"
								GridPane.columnIndex="1" />
							<TextArea fx:id="detDescriptionEditor"
								maxWidth="1.7976931348623157E308" prefRowCount="8"
								minHeight="170" wrapText="true"
								GridPane.rowIndex="4" GridPane.columnIndex="1" />
						</GridPane>
					</VBox>
					
					
					<VBox spacing="10" styleClass="secondary-panel">
						<Label text="Incident &amp; Deadlines"
							style="-fx-font-weight: bold; -fx-opacity: 0.9;" />
						<GridPane hgap="14" vgap="10"
							style="-fx-alignment: TOP_LEFT;">
							<columnConstraints>
								<ColumnConstraints minWidth="210"
									prefWidth="230" />
								<ColumnConstraints hgrow="ALWAYS"
									fillWidth="true" />
							</columnConstraints>
							<Label text="Date of Medical Negligence:"
								style="-fx-opacity: 0.8;" GridPane.rowIndex="0" />
							<Label fx:id="detDateOfMedicalNegligenceValue" text="—"
								GridPane.rowIndex="0" GridPane.columnIndex="1" />
							<DatePicker fx:id="detDateOfMedicalNegligenceEditor"
								maxWidth="1.7976931348623157E308" visible="false"
								managed="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />
							<Label text="Date Medical Negligence Was Discovered:"
								style="-fx-opacity: 0.8;" GridPane.rowIndex="1" />
							<Label fx:id="detDateMedicalNegligenceWasDiscoveredValue"
								text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" />
							<DatePicker
								fx:id="detDateMedicalNegligenceWasDiscoveredEditor"
								maxWidth="1.7976931348623157E308" visible="false"
								managed="false" GridPane.rowIndex="1" GridPane.columnIndex="1" />
							<Label text="Date of Injury:" style="-fx-opacity: 0.8;"
								GridPane.rowIndex="2" />
