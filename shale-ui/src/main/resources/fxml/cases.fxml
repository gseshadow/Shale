<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.CasesController" styleClass="app-shell" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">

	<top>
		<HBox spacing="10" styleClass="cases-filter-bar strong-panel">
			<padding>
				<Insets top="10" right="10" bottom="10" left="10" />
			</padding>
			<ToggleButton fx:id="cardsViewToggle" text="Cards" selected="true" />
			<ToggleButton fx:id="gridViewToggle" text="List" />
			<TextField fx:id="casesSearchField"
				promptText="Search cases…" HBox.hgrow="ALWAYS" />
			<MenuButton fx:id="statusFilterMenuButton" text="Status (8/8)">
				<styleClass>
					<String fx:value="menu-button" />
					<String fx:value="app-toolbar-button" />
					<String fx:value="app-toolbar-button-neutral" />
				</styleClass>
			</MenuButton>
			<ChoiceBox fx:id="casesSortChoice" prefWidth="220">
				<styleClass>
					<String fx:value="choice-box" />
					<String fx:value="app-toolbar-select" />
				</styleClass>
			</ChoiceBox>
			<MenuButton fx:id="columnMenuButton" text="Customize Columns">
				<styleClass>
					<String fx:value="menu-button" />
					<String fx:value="app-toolbar-button" />
					<String fx:value="app-toolbar-button-neutral" />
				</styleClass>
			</MenuButton>
			<Label fx:id="resultsCountLabel" text="0 results" styleClass="cases-results-count" />
		</HBox>
	</top>

	<center>
		<AnchorPane minHeight="0.0" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
			<ScrollPane fx:id="casesScroll" fitToWidth="true" fitToHeight="true" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
				pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="surface-scroll">
				<content>
					<FlowPane fx:id="casesFlow" hgap="10" vgap="10"
						prefWrapLength="1180" styleClass="cases-content-surface glass-panel">
						<padding>
							<Insets top="10" right="10" bottom="10" left="10" />
						</padding>
					</FlowPane>
				</content>
			</ScrollPane>
			<TableView fx:id="casesTable" visible="false" managed="false" minHeight="0.0" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" styleClass="cases-content-surface" />
		</AnchorPane>
	</center>

</BorderPane>
