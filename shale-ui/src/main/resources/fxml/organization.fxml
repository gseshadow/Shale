<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.OrganizationController" styleClass="app-shell, shell-route-page">
    <top>
        <VBox fx:id="organizationHeaderSurface" spacing="9" BorderPane.alignment="CENTER">
            <styleClass><String fx:value="page-header-surface"/><String fx:value="organization-profile-header"/></styleClass>
            <padding><Insets top="16" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="organizationTitleLabel" text="Organization" wrapText="true"
                maxWidth="1.7976931348623157E308" styleClass="shale-page-title"/>
            <Label text="Organization profile" styleClass="shale-metadata-muted"/>
            <FlowPane fx:id="organizationTypeChips" hgap="6" vgap="6" alignment="TOP_LEFT" prefWrapLength="760"
                styleClass="organization-profile-classifications"/>
            <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" prefWrapLength="760" styleClass="organization-profile-toolbar">
                <Label fx:id="removedStateLabel" text="Removed organization" visible="false" managed="false"
                    styleClass="shale-semantic-chip, shale-semantic-chip-danger"/>
                <Label fx:id="lastUpdatedLabel" text="Last updated: —" styleClass="shale-metadata-muted"/>
                <Button fx:id="manageOrganizationTypesButton" text="Manage Organization Types" visible="false" managed="false"/>
                <Button fx:id="editButton" text="Edit Organization" visible="false" managed="false"/>
                <Button fx:id="deleteOrganizationButton" text="Delete Organization" visible="false" managed="false"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="profileScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="surface-scroll">
            <FlowPane fx:id="profileColumns" hgap="16" vgap="16" alignment="TOP_LEFT" prefWrapLength="1180">
                <padding><Insets top="14" right="14" bottom="18" left="14"/></padding>
                <VBox fx:id="profilePrimaryColumn" spacing="12" minWidth="0" prefWidth="760" maxWidth="900" styleClass="organization-profile-primary">
                    <Label fx:id="errorLabel" wrapText="true" visible="false" managed="false" styleClass="shale-error-message"/>
                    <HBox fx:id="remoteUpdateBanner" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false"
                        styleClass="shale-section-card">
                        <Label text="This organization was updated elsewhere." wrapText="true" styleClass="shale-error-message"/>
                        <Button fx:id="reloadRemoteButton" text="Reload"/>
                    </HBox>
                    <VBox spacing="12" styleClass="shale-section-card, organization-profile-contact-card">
                        <Label text="Contact Information" styleClass="shale-section-title"/>
                        <VBox fx:id="phoneSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Phone Numbers" styleClass="shale-subsection-title"/>
                            <TilePane fx:id="phoneCards" hgap="10" vgap="10" prefColumns="2"/>
                        </VBox>
                        <VBox fx:id="emailSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Email Addresses" styleClass="shale-subsection-title"/>
                            <TilePane fx:id="emailCards" hgap="10" vgap="10" prefColumns="2"/>
                        </VBox>
                        <VBox fx:id="addressSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Addresses" styleClass="shale-subsection-title"/>
                            <VBox fx:id="addressCards" spacing="8"/>
                        </VBox>
                        <VBox fx:id="websiteSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Websites" styleClass="shale-subsection-title"/>
                            <VBox fx:id="websiteCards" spacing="8"/>
                        </VBox>
                    </VBox>
                    <VBox fx:id="notesSection" spacing="8" styleClass="shale-section-card">
                        <Label text="Notes" styleClass="shale-section-title"/>
                        <HBox styleClass="shale-property-row, shale-property-row-comfortable">
                            <Label text="Notes" minWidth="92" styleClass="shale-property-row-label"/>
                            <Label fx:id="notesValue" wrapText="true" minWidth="0" maxWidth="1.7976931348623157E308"
                                styleClass="shale-property-row-value" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </VBox>
                <VBox fx:id="profileRelatedColumn" prefWidth="380" minWidth="0" maxWidth="480" spacing="10" styleClass="shale-section-card, organization-profile-related-card">
                    <Label text="Related Cases" styleClass="shale-section-title"/>
                    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" prefWrapLength="350">
                        <TextField fx:id="relatedCasesSearchField" promptText="Search related cases…" prefWidth="230"/>
                        <ChoiceBox fx:id="relatedCasesSortChoice" prefWidth="180"/>
                    </FlowPane>
                    <StackPane>
                        <VBox fx:id="relatedCasesContainer" spacing="10" fillWidth="true" maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="relatedCasesEmptyLabel" text="No related cases" visible="false" managed="false"
                            wrapText="true" styleClass="shale-empty-message"/>
                    </StackPane>
                </VBox>
            </FlowPane>
        </ScrollPane>
    </center>
</BorderPane>
