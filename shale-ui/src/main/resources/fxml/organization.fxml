<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.OrganizationController" styleClass="app-shell">

    <top>
        <VBox spacing="6.0" BorderPane.alignment="CENTER" styleClass="page-header-surface">
            <padding>
                <Insets top="10" right="12" bottom="8" left="12" />
            </padding>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="organizationTitleLabel" text="Organization" wrapText="true" styleClass="functional-heading" />
                    <FlowPane fx:id="organizationTypeChips" hgap="6" vgap="6" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="editButton" text="Edit Organization" visible="false" managed="false" />
                <Button fx:id="deleteOrganizationButton" text="Delete Organization" visible="false" managed="false"
                    styleClass="button app-toolbar-button app-toolbar-button-danger" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lastUpdatedLabel" text="Last updated: —" styleClass="functional-metadata" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="12" bottom="12" left="12" />
            </padding>

            <HBox spacing="16" maxWidth="1360" alignment="TOP_LEFT">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12" />
                </padding>

                <VBox spacing="10" styleClass="case-main-surface" minWidth="640" prefWidth="820" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12" />
                    </padding>

                    <Label fx:id="errorLabel" textFill="#b42318" wrapText="true" visible="false" managed="false" />

                    <HBox fx:id="remoteUpdateBanner" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label text="This organization was updated elsewhere." style="-fx-text-fill: #b42318;" />
                        <Button fx:id="reloadRemoteButton" text="Reload" />
                    </HBox>

                    <VBox spacing="12" styleClass="organization-profile-sections">
                        <Label text="Contact Information" styleClass="functional-heading" />
                        <VBox fx:id="phoneSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Phone Numbers" styleClass="case-overview-row-label" />
                            <TilePane fx:id="phoneCards" hgap="10" vgap="10" prefColumns="2" />
                        </VBox>
                        <VBox fx:id="emailSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Email Addresses" styleClass="case-overview-row-label" />
                            <TilePane fx:id="emailCards" hgap="10" vgap="10" prefColumns="2" />
                        </VBox>
                        <VBox fx:id="addressSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Addresses" styleClass="case-overview-row-label" />
                            <VBox fx:id="addressCards" spacing="8" />
                        </VBox>
                        <VBox fx:id="websiteSection" spacing="8" styleClass="contact-method-section">
                            <Label text="Websites" styleClass="case-overview-row-label" />
                            <VBox fx:id="websiteCards" spacing="8" />
                        </VBox>
                        <VBox spacing="6" styleClass="contact-method-section">
                            <Label text="Notes" styleClass="case-overview-row-label" />
                            <Label fx:id="notesValue" text="—" wrapText="true" styleClass="case-overview-row-value" />
                        </VBox>
                    </VBox>
                </VBox>

                <VBox prefWidth="460" minWidth="400" maxWidth="560" maxHeight="1.7976931348623157E308" spacing="10" styleClass="secondary-panel">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12" />
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Related Cases" style="-fx-font-weight: bold; -fx-opacity: 0.9;" />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="relatedCasesSearchField" promptText="Search related cases…" HBox.hgrow="ALWAYS" />
                        <ChoiceBox fx:id="relatedCasesSortChoice" prefWidth="180" />
                    </HBox>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="surface-scroll" VBox.vgrow="ALWAYS">
                        <StackPane>
                            <VBox fx:id="relatedCasesContainer" spacing="10" fillWidth="true" maxWidth="1.7976931348623157E308">
                                <padding>
                                    <Insets right="8" />
                                </padding>
                            </VBox>
                            <Label fx:id="relatedCasesEmptyLabel" text="No related cases" visible="false" managed="false" />
                        </StackPane>
                    </ScrollPane>
                </VBox>
            </HBox>
        </StackPane>
    </center>

</BorderPane>
