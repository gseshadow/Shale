<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.OrganizationController" styleClass="app-shell">

    <top>
        <VBox spacing="6.0" BorderPane.alignment="CENTER" styleClass="page-header-surface">
            <padding>
                <Insets top="10" right="12" bottom="8" left="12" />
            </padding>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="organizationTitleLabel" text="Organization" styleClass="functional-heading" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="saveButton" text="Save" visible="false" managed="false">
                    <styleClass>
                        <String fx:value="button" />
                        <String fx:value="app-toolbar-button" />
                        <String fx:value="app-toolbar-button-primary" />
                    </styleClass>
                </Button>
                <Button fx:id="cancelButton" text="Cancel" visible="false" managed="false">
                    <styleClass>
                        <String fx:value="button" />
                        <String fx:value="app-toolbar-button" />
                        <String fx:value="app-toolbar-button-neutral" />
                    </styleClass>
                </Button>
                <Button fx:id="deleteOrganizationButton" text="Delete Organization" visible="false" managed="false">
                    <styleClass>
                        <String fx:value="button" />
                        <String fx:value="app-toolbar-button" />
                        <String fx:value="app-toolbar-button-danger" />
                    </styleClass>
                </Button>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lastUpdatedLabel" text="Last updated: —" styleClass="functional-metadata" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="12" bottom="12" left="12" />
            </padding>

            <HBox spacing="16" maxWidth="1360" alignment="TOP_LEFT">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12" />
                </padding>

                <VBox spacing="10" styleClass="case-main-surface" minWidth="640" prefWidth="820" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12" />
                    </padding>

                    <Label fx:id="errorLabel" textFill="#b42318" wrapText="true" visible="false" managed="false" />

                    <HBox fx:id="remoteUpdateBanner" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label text="This organization was updated elsewhere." style="-fx-text-fill: #b42318;" />
                        <Button fx:id="reloadRemoteButton" text="Reload" />
                    </HBox>

                    <GridPane hgap="14" vgap="0" styleClass="case-overview-rows">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="170" />
                            <ColumnConstraints hgrow="ALWAYS" fillWidth="true" />
                            <ColumnConstraints minWidth="36" prefWidth="36" maxWidth="36" halignment="RIGHT" />
                        </columnConstraints>

                        <Label text="Name" styleClass="case-overview-row-label" GridPane.rowIndex="0" />
                        <Label fx:id="nameValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                        <TextField fx:id="nameEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            <Button fx:id="editNameButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="0" GridPane.columnIndex="2" />

                            <Label text="Organization Type" styleClass="case-overview-row-label" GridPane.rowIndex="1" />
                            <Label fx:id="typeValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            <ComboBox fx:id="typeEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            <Button fx:id="editTypeButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="1" GridPane.columnIndex="2" />

                            <Label text="Phone" styleClass="case-overview-row-label" GridPane.rowIndex="2" />
                            <Label fx:id="phoneValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            <TextField fx:id="phoneEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            <Button fx:id="editPhoneButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="2" GridPane.columnIndex="2" />

                            <Label text="Fax" styleClass="case-overview-row-label" GridPane.rowIndex="3" />
                            <Label fx:id="faxValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            <TextField fx:id="faxEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            <Button fx:id="editFaxButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="3" GridPane.columnIndex="2" />

                            <Label text="Email" styleClass="case-overview-row-label" GridPane.rowIndex="4" />
                            <Label fx:id="emailValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                            <TextField fx:id="emailEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                            <Button fx:id="editEmailButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="4" GridPane.columnIndex="2" />

                            <Label text="Website" styleClass="case-overview-row-label" GridPane.rowIndex="5" />
                            <Label fx:id="websiteValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                            <TextField fx:id="websiteEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                            <Button fx:id="editWebsiteButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="5" GridPane.columnIndex="2" />

                            <Label text="Address1" styleClass="case-overview-row-label" GridPane.rowIndex="6" />
                            <Label fx:id="address1Value" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                            <TextField fx:id="address1Editor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                            <Button fx:id="editAddress1Button" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="6" GridPane.columnIndex="2" />

                            <Label text="Address2" styleClass="case-overview-row-label" GridPane.rowIndex="7" />
                            <Label fx:id="address2Value" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                            <TextField fx:id="address2Editor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                            <Button fx:id="editAddress2Button" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="7" GridPane.columnIndex="2" />

                            <Label text="City" styleClass="case-overview-row-label" GridPane.rowIndex="8" />
                            <Label fx:id="cityValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="8" GridPane.columnIndex="1" />
                            <TextField fx:id="cityEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="8" GridPane.columnIndex="1" />
                            <Button fx:id="editCityButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="8" GridPane.columnIndex="2" />

                            <Label text="State" styleClass="case-overview-row-label" GridPane.rowIndex="9" />
                            <Label fx:id="stateValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="9" GridPane.columnIndex="1" />
                            <TextField fx:id="stateEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="9" GridPane.columnIndex="1" />
                            <Button fx:id="editStateButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="9" GridPane.columnIndex="2" />

                            <Label text="Postal Code" styleClass="case-overview-row-label" GridPane.rowIndex="10" />
                            <Label fx:id="postalCodeValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="10" GridPane.columnIndex="1" />
                            <TextField fx:id="postalCodeEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="10" GridPane.columnIndex="1" />
                            <Button fx:id="editPostalCodeButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="10" GridPane.columnIndex="2" />

                            <Label text="Country" styleClass="case-overview-row-label" GridPane.rowIndex="11" />
                            <Label fx:id="countryValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="11" GridPane.columnIndex="1" />
                            <TextField fx:id="countryEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" GridPane.rowIndex="11" GridPane.columnIndex="1" />
                            <Button fx:id="editCountryButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="11" GridPane.columnIndex="2" />

                        <Label text="Notes" styleClass="case-overview-row-label" GridPane.rowIndex="12" />
                        <Label fx:id="notesValue" text="—" wrapText="true" styleClass="case-overview-row-value" GridPane.rowIndex="12" GridPane.columnIndex="1" />
                        <TextArea fx:id="notesEditor" visible="false" managed="false" maxWidth="1.7976931348623157E308" prefRowCount="4" wrapText="true" GridPane.rowIndex="12" GridPane.columnIndex="1" />
                            <Button fx:id="editNotesButton" text="✎" styleClass="case-overview-edit-button" GridPane.rowIndex="12" GridPane.columnIndex="2" />
                    </GridPane>
                </VBox>

                <VBox prefWidth="460" minWidth="400" maxWidth="560" maxHeight="1.7976931348623157E308" spacing="10" styleClass="secondary-panel">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12" />
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Related Cases" style="-fx-font-weight: bold; -fx-opacity: 0.9;" />
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="relatedCasesSearchField" promptText="Search related cases…" HBox.hgrow="ALWAYS" />
                        <ChoiceBox fx:id="relatedCasesSortChoice" prefWidth="180" />
                    </HBox>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="surface-scroll" VBox.vgrow="ALWAYS">
                        <StackPane>
                            <VBox fx:id="relatedCasesContainer" spacing="10" fillWidth="true" maxWidth="1.7976931348623157E308">
                                <padding>
                                    <Insets right="8" />
                                </padding>
                            </VBox>
                            <Label fx:id="relatedCasesEmptyLabel" text="No related cases" visible="false" managed="false" />
                        </StackPane>
                    </ScrollPane>
                </VBox>
            </HBox>
        </StackPane>
    </center>

</BorderPane>
