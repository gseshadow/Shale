<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.shale.ui.component.ScrollableListRegion?>
<?import com.shale.ui.component.FilterPanel?>
<?import com.shale.ui.component.ShaleFilterMenu?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.OrganizationsController" styleClass="app-shell">

	<top>
		<FilterPanel><left><FlowPane hgap="8" vgap="8" styleClass="contact-filter-controls">
			<Button fx:id="addOrganizationButton" text="Add Organization" />
			<TextField fx:id="organizationsSearchField" promptText="Search organizations…" prefWidth="250" />
			<ShaleFilterMenu fx:id="organizationTypeFilter" />
			<Button fx:id="showRemovedOrganizationsButton" text="Show removed" onAction="#toggleRemovedOrganizations" />
			<ComboBox fx:id="organizationSort" prefWidth="120" />
			<Label fx:id="activeFilterCount" text="0 filters" styleClass="contact-filter-count" />
			<Button fx:id="clearFiltersButton" text="Clear Filters" onAction="#clearFilters" styleClass="contact-filter-clear" />
		</FlowPane></left><right><FlowPane fx:id="selectedFilterChips" hgap="6" vgap="6" /></right></FilterPanel>
	</top>

	<center>
		<ScrollableListRegion fx:id="organizationsListRegion">
			<content>
				<FlowPane fx:id="organizationsFlow" hgap="16" vgap="16"
					prefWrapLength="1040" styleClass="cases-content-surface glass-panel data-surface">
					<padding>
						<Insets top="16" right="16" bottom="16" left="16" />
					</padding>
				</FlowPane>
			</content>
			<emptyLabel>
				<Label fx:id="organizationsEmptyStateLabel"
					text="No organizations to display yet." styleClass="shale-empty-state"
					visible="false" managed="false" />
			</emptyLabel>
			<loadingLabel>
				<Label fx:id="organizationsLoadingStateLabel"
					text="Loading organizations…" styleClass="shale-loading-placeholder"
					visible="false" managed="false" />
			</loadingLabel>
		</ScrollableListRegion>
	</center>

</BorderPane>
