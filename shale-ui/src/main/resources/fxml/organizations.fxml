<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.shale.ui.component.ScrollableListRegion?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.OrganizationsController" styleClass="app-shell">

	<top>
		<HBox spacing="10" styleClass="cases-filter-bar strong-panel">
			<padding>
				<Insets top="14" right="14" bottom="14" left="14" />
			</padding>
			<TextField fx:id="organizationsSearchField"
				promptText="Search organizations…" HBox.hgrow="ALWAYS" />
			<Button fx:id="addOrganizationButton" text="Add Organization">
				<styleClass>
					<String fx:value="button" />
					<String fx:value="app-toolbar-button" />
					<String fx:value="app-toolbar-button-primary" />
				</styleClass>
			</Button>
		</HBox>
	</top>

	<center>
		<ScrollableListRegion fx:id="organizationsListRegion">
			<content>
				<FlowPane fx:id="organizationsFlow" hgap="16" vgap="16"
					prefWrapLength="1040" styleClass="cases-content-surface glass-panel">
					<padding>
						<Insets top="16" right="16" bottom="16" left="16" />
					</padding>
				</FlowPane>
			</content>
			<emptyLabel>
				<Label fx:id="organizationsEmptyStateLabel"
					text="No organizations to display yet." styleClass="shale-empty-state"
					visible="false" managed="false" />
			</emptyLabel>
			<loadingLabel>
				<Label fx:id="organizationsLoadingStateLabel"
					text="Loading organizations…" styleClass="shale-loading-placeholder"
					visible="false" managed="false" />
			</loadingLabel>
		</ScrollableListRegion>
	</center>

</BorderPane>
