<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="com.shale.ui.controller.MainController" styleClass="app-shell">

	<!-- Top bar -->
	<top>
		<HBox fx:id="topToolbar" spacing="12">
			<styleClass>
				<String fx:value="top-bar" />
				<String fx:value="app-header" />
			</styleClass>
			<children>
				<HBox spacing="12" alignment="CENTER_LEFT" styleClass="shell-leading-actions">
					<children>
						<Label fx:id="brandLabel" text="SHALE" styleClass="app-brand" />
						<Button fx:id="backButton" text="←" onAction="#onBack" disable="true"
							styleClass="topbar-back-button" />
					</children>
				</HBox>
				<!-- Global search owns the flexible middle width and shrinks before trailing actions. -->
				<HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
					minWidth="180" maxWidth="620" styleClass="shell-search-group">
					<children>
						<TextField fx:id="globalSearchField"
							promptText="Search cases, contacts, tasks..." HBox.hgrow="ALWAYS"
							minWidth="120" styleClass="global-search-field" />
						<Button fx:id="globalSearchButton" text="Search"
							onAction="#onGlobalSearch" />
					</children>
				</HBox>

				<Button fx:id="newIntakeButton" text="New Intake"
					onAction="#onNewIntake" />


				<Region HBox.hgrow="ALWAYS" />
				<HBox spacing="8" alignment="CENTER_RIGHT" minWidth="-Infinity"
					styleClass="shell-trailing-actions">
					<children>
						<HBox fx:id="notificationBannerHost" spacing="8" alignment="CENTER_LEFT"
							styleClass="notification-banner-host" visible="false" managed="false">
							<children>
								<Label fx:id="notificationBannerLabel" text="Update available"
									styleClass="notification-banner-label" />
							</children>
						</HBox>
						<Button fx:id="notificationBellButton" text="🔔"
							onAction="#onOpenNotificationCenter" styleClass="notification-bell-button shell-icon-button" />
						<Button fx:id="profileButton" text="Profile" onAction="#onProfile"
							styleClass="profile-button" />
					</children>
				</HBox>
			</children>
		</HBox>
	</top>

	<!-- Left navigation sidebar -->
	<left>
		<VBox fx:id="navigationSidebar" spacing="0">
			<styleClass>
				<String fx:value="sidebar" />
				<String fx:value="nav-rail" />
			</styleClass>
			<children>
				<Label text="Navigation" styleClass="sidebar-header" />
				<VBox fx:id="navigationItems" spacing="6" fillWidth="true" styleClass="navigation-items" VBox.vgrow="ALWAYS">
					<children>
						<Button fx:id="navMyShaleButton" text="My Shale" maxWidth="Infinity" onAction="#onNavMyShale" />
						<Button fx:id="navCasesButton" text="Cases" maxWidth="Infinity" onAction="#onNavCases" />
						<Button fx:id="navContactsButton" text="Contacts" maxWidth="Infinity" onAction="#onNavContacts" />
						<Button fx:id="navOrganizationsButton" text="Organizations" maxWidth="Infinity" onAction="#onNavOrganizations" />
						<Button fx:id="navTeamButton" text="Team" maxWidth="Infinity" onAction="#onNavTeam" />
						<Button fx:id="navReportsButton" text="Reports" maxWidth="Infinity" onAction="#onNavReports" />
						<Button fx:id="navCalendarButton" text="Calendar" maxWidth="Infinity" onAction="#onNavCalendar" />
						<Button fx:id="navSettingsButton" text="Settings" maxWidth="Infinity" onAction="#onNavSettings" />
					</children>
				</VBox>
			</children>
		</VBox>
	</left>

	<!-- Main content area (shell-controlled) -->
	<center>
		<VBox spacing="6" styleClass="content-root" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
			<children>
				<!-- Shared readability boundary for every routed primary destination. -->
				<VBox spacing="6" styleClass="primary-content-surface" VBox.vgrow="ALWAYS"
					maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
					<children>
						<VBox fx:id="sectionHeaderBox" spacing="2" styleClass="shell-section-header">
							<children>
								<Label fx:id="sectionTitleLabel" text="My Shale"
									styleClass="section-title" />
								<Label fx:id="sectionSubtitleLabel" wrapText="true"
									text="Select a section from the left to get started."
									styleClass="functional-metadata" />
							</children>
						</VBox>

						<!-- Shell-controlled content placeholder -->
						<StackPane fx:id="sectionContent" VBox.vgrow="ALWAYS" styleClass="shell-route-outlet" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
							<children>
								<Label fx:id="placeholderLabel"
									text="This section is not implemented yet." />
							</children>
						</StackPane>
					</children>
				</VBox>
			</children>
		</VBox>
	</center>

	<bottom>
		<HBox spacing="8" alignment="CENTER_LEFT" styleClass="session-footer">
			<children>
				<Label text="Signed in as:" />
				<Label fx:id="userEmailLabel" text="user@example.com"
					styleClass="user-email" />
				<Region HBox.hgrow="ALWAYS" />
				<Button fx:id="logoutButton" text="Logout" onAction="#onLogout" />
			</children>
		</HBox>
	</bottom>
</BorderPane>
