<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="loginRoot" minWidth="640" minHeight="560" styleClass="login-root"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.LoginController">
	<children>
		<Circle fx:id="backgroundGlow" radius="260" mouseTransparent="true" styleClass="login-background-glow"
			StackPane.alignment="TOP_LEFT" />
		<HBox fx:id="loginContent" alignment="CENTER" fillHeight="true" spacing="56" maxWidth="1220"
			styleClass="login-content">
			<StackPane fx:id="brandPane" HBox.hgrow="ALWAYS" minWidth="500" prefWidth="540" maxWidth="560"
				styleClass="login-brand-pane">
				<children>
					<VBox alignment="TOP_LEFT" spacing="0" minWidth="500" prefWidth="540" maxWidth="560"
						maxHeight="USE_PREF_SIZE" styleClass="login-brand-group">
						<ImageView fx:id="logoImage" fitWidth="190" preserveRatio="true" smooth="true" />
						<VBox spacing="0" styleClass="login-headline-block">
							<Label text="Your practice." styleClass="login-headline" />
							<Label text="In order." styleClass="login-headline,login-headline-accent" />
						</VBox>
						<Label text="Cases, tasks, and your team. Together in Shale." wrapText="true"
							styleClass="login-tagline" />
						<StackPane fx:id="loginIllustration" minWidth="500" prefWidth="540" maxWidth="560"
							minHeight="300" prefHeight="310" maxHeight="330" styleClass="login-illustration">
							<children>
								<VBox spacing="12" minWidth="218" prefWidth="218" maxWidth="218" minHeight="252"
									prefHeight="252" maxHeight="252" styleClass="login-demo-card,login-demo-case"
									StackPane.alignment="TOP_LEFT">
									<Label text="CASES" styleClass="login-demo-kicker" />
									<Label text="Active matters" styleClass="login-demo-title" />
									<HBox alignment="CENTER_LEFT" spacing="9"><Circle radius="5" styleClass="login-dot-teal"/><VBox spacing="5"><Rectangle width="126" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line-strong"/><Rectangle width="92" height="6" arcWidth="6" arcHeight="6" styleClass="login-demo-line"/></VBox></HBox>
									<HBox alignment="CENTER_LEFT" spacing="9"><Circle radius="5" styleClass="login-dot-violet"/><VBox spacing="5"><Rectangle width="112" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line-strong"/><Rectangle width="136" height="6" arcWidth="6" arcHeight="6" styleClass="login-demo-line"/></VBox></HBox>
									<HBox alignment="CENTER_LEFT" spacing="9"><Circle radius="5" styleClass="login-dot-blue"/><VBox spacing="5"><Rectangle width="132" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line-strong"/><Rectangle width="104" height="6" arcWidth="6" arcHeight="6" styleClass="login-demo-line"/></VBox></HBox>
								</VBox>
								<VBox spacing="13" minWidth="214" prefWidth="214" maxWidth="214" minHeight="238"
									prefHeight="238" maxHeight="238" styleClass="login-demo-card,login-demo-task"
									StackPane.alignment="TOP_RIGHT">
									<Label text="TASKS" styleClass="login-demo-kicker" />
									<Label text="Today" styleClass="login-demo-title" />
									<HBox alignment="CENTER_LEFT" spacing="10"><Label text="✓" styleClass="login-check"/><Rectangle width="124" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line-strong"/></HBox>
									<HBox alignment="CENTER_LEFT" spacing="10"><Label text="✓" styleClass="login-check"/><Rectangle width="104" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line"/></HBox>
									<HBox alignment="CENTER_LEFT" spacing="10"><Label text="○" styleClass="login-check-muted"/><Rectangle width="132" height="8" arcWidth="8" arcHeight="8" styleClass="login-demo-line"/></HBox>
								</VBox>
								<VBox spacing="10" minWidth="226" prefWidth="226" maxWidth="226" minHeight="236"
									prefHeight="236" maxHeight="236" styleClass="login-demo-card,login-demo-calendar"
									StackPane.alignment="BOTTOM_CENTER">
									<Label text="CALENDAR" styleClass="login-demo-kicker" />
									<HBox alignment="CENTER_LEFT" spacing="10"><Label text="OCT" styleClass="login-calendar-month"/><Label text="Your week" styleClass="login-demo-title"/></HBox>
									<GridPane hgap="8" vgap="8" styleClass="login-calendar-grid">
										<Label text="M" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="login-calendar-day"/><Label text="T" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="login-calendar-day"/><Label text="W" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="login-calendar-day"/><Label text="T" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="login-calendar-day"/><Label text="F" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="login-calendar-day"/>
										<Label text="7" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="login-calendar-cell"/><Label text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="login-calendar-cell"/><Label text="9" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="login-calendar-cell,login-calendar-selected"/><Label text="10" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="login-calendar-cell"/><Label text="11" GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="login-calendar-cell"/>
										<Label text="14" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="login-calendar-cell"/><Label text="15" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="login-calendar-cell"/><Label text="16" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="login-calendar-cell"/><Label text="17" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="login-calendar-cell"/><Label text="18" GridPane.columnIndex="4" GridPane.rowIndex="2" styleClass="login-calendar-cell"/>
									</GridPane>
								</VBox>
							</children>
						</StackPane>
						<VBox spacing="7" minWidth="500" prefWidth="540" maxWidth="560" styleClass="login-whats-new">
							<Label text="WHAT'S NEW" styleClass="login-whats-new-kicker" />
							<Label text="Release-specific highlights and a clearer required-update experience."
								wrapText="true" styleClass="login-whats-new-text" />
						</VBox>
					</VBox>
				</children>
			</StackPane>
			<ScrollPane fx:id="loginFormScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
				vbarPolicy="AS_NEEDED" minWidth="380" prefWidth="420" maxWidth="440" styleClass="login-form-scroll">
				<content>
					<StackPane minWidth="380" prefWidth="420" maxWidth="440" styleClass="login-card-centering-pane">
						<VBox spacing="16" minWidth="380" prefWidth="420" maxWidth="440" maxHeight="USE_PREF_SIZE"
							styleClass="login-card">
							<Label text="Welcome back" styleClass="login-card-title" />
							<Label text="Sign in to your workspace." styleClass="login-card-subtitle" />
							<VBox spacing="7"><Label text="Email" labelFor="$emailField" styleClass="login-field-label"/><TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity"/></VBox>
							<VBox spacing="7">
								<Label text="Password" labelFor="$passwordField" styleClass="login-field-label" />
								<StackPane><PasswordField fx:id="passwordField" promptText="Enter your password" maxWidth="Infinity"/><TextField fx:id="visiblePasswordField" promptText="Enter your password" maxWidth="Infinity" visible="false" managed="false"/></StackPane>
								<ToggleButton fx:id="passwordVisibilityButton" text="Show password" onAction="#onPasswordVisibilityChanged" styleClass="login-password-toggle" />
							</VBox>
							<HBox alignment="CENTER_LEFT" spacing="10" styleClass="login-stay-row"><CheckBox fx:id="stayLoggedInCheckBox" text="Stay logged in" disable="true"><tooltip><Tooltip text="Persistent sessions are not available yet. Shale will continue to sign you out normally." wrapText="true"/></tooltip></CheckBox><Label text="Coming soon" styleClass="login-coming-soon"/></HBox>
							<Label text="Only on your personal device." styleClass="login-supporting-text" />
							<Button fx:id="signInButton" text="Sign in" onAction="#onSignIn" defaultButton="true" maxWidth="Infinity" />
							<Label fx:id="progressLabel" text="Signing in…" visible="false" managed="false" minHeight="20" styleClass="login-progress" />
							<Label fx:id="errorLabel" wrapText="true" minHeight="40" styleClass="login-error" />
						</VBox>
					</StackPane>
				</content>
			</ScrollPane>
		</HBox>
		<Label fx:id="versionLabel" styleClass="login-version-label" StackPane.alignment="BOTTOM_LEFT" />
	</children>
	<padding><Insets top="30" right="42" bottom="26" left="42" /></padding>
</StackPane>
