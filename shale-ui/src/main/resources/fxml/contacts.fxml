<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import com.shale.ui.component.FilterPanel?>
<?import com.shale.ui.component.ShaleFilterMenu?>
<?import com.shale.ui.component.ScrollableListRegion?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.ContactsController"
    styleClass="app-shell, shell-route-page, contacts-page">
    <top>
        <VBox spacing="12" styleClass="contacts-page-header">
            <VBox spacing="4">
                <Label text="Contacts" styleClass="shale-page-title" />
                <Label text="Search and browse the people connected to your work."
                    wrapText="true" styleClass="shale-metadata-muted" />
            </VBox>
            <FilterPanel styleClass="shale-filter-panel, shale-toolbar, contacts-toolbar">
                <left>
                    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="contacts-toolbar-controls">
                        <TextField fx:id="contactsSearchField" promptText="Search contacts…" prefWidth="280" />
                        <ShaleFilterMenu fx:id="contactTypeFilter" />
                        <ShaleFilterMenu fx:id="specialtyFilter" />
                        <ShaleFilterMenu fx:id="credentialFilter" />
                        <Label fx:id="activeFilterCount" text="0 filters" styleClass="contact-filter-count" />
                        <Button fx:id="clearFiltersButton" text="Clear All" onAction="#clearFilters" />
                        <Button fx:id="addContactButton" text="Add Contact" onAction="#addContact" />
                    </FlowPane>
                </left>
                <right><Label fx:id="contactsResultCount" text="0 results" styleClass="contacts-results-count" /></right>
            </FilterPanel>
            <FlowPane fx:id="selectedFilterChips" hgap="6" vgap="6" styleClass="contacts-selected-filters" />
        </VBox>
    </top>
    <center>
        <ScrollableListRegion fx:id="contactsListRegion">
            <content>
                <FlowPane fx:id="contactsFlow" hgap="12" vgap="12" prefWrapLength="1040"
                    styleClass="contacts-content-surface">
                    <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>
                </FlowPane>
            </content>
            <emptyLabel><Label fx:id="contactsEmptyStateLabel" text="No contacts to display yet."
                styleClass="shale-empty-state" visible="false" managed="false" /></emptyLabel>
            <loadingLabel><Label fx:id="contactsLoadingStateLabel" text="Loading contacts…"
                styleClass="shale-loading-placeholder" visible="false" managed="false" /></loadingLabel>
        </ScrollableListRegion>
    </center>
</BorderPane>
