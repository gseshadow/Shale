<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import com.shale.ui.component.FilterPanel?>
<?import com.shale.ui.component.ScrollableListRegion?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.ContactsController" styleClass="app-shell">

    <top>
        <FilterPanel>
            <left>
                <HBox spacing="8">
                    <TextField fx:id="contactsSearchField" promptText="Search contacts…" />
                    <MenuButton fx:id="contactTypeFilter" text="Contact Type" />
                    <MenuButton fx:id="specialtyFilter" text="Specialty" />
                    <MenuButton fx:id="credentialFilter" text="Credential" />
                    <Label fx:id="activeFilterCount" text="0 filters" styleClass="muted-text" />
                    <Button fx:id="clearFiltersButton" text="Clear All" onAction="#clearFilters" />
                </HBox>
            </left>
            <right><FlowPane fx:id="selectedFilterChips" hgap="6" vgap="6" /></right>
        </FilterPanel>
    </top>

    <center>
        <ScrollableListRegion fx:id="contactsListRegion">
            <content>
                <FlowPane fx:id="contactsFlow" hgap="16" vgap="16"
                    prefWrapLength="1040" styleClass="cases-content-surface glass-panel">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                </FlowPane>
            </content>
            <emptyLabel>
                <Label fx:id="contactsEmptyStateLabel"
                    text="No contacts to display yet." styleClass="shale-empty-state"
                    visible="false" managed="false" />
            </emptyLabel>
            <loadingLabel>
                <Label fx:id="contactsLoadingStateLabel"
                    text="Loading contacts…" styleClass="shale-loading-placeholder"
                    visible="false" managed="false" />
            </loadingLabel>
        </ScrollableListRegion>
    </center>

</BorderPane>
