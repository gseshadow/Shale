<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import com.shale.ui.component.FilterPanel?>
<?import com.shale.ui.component.ScrollableListRegion?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.shale.ui.controller.ContactsController" styleClass="app-shell">

    <top>
        <FilterPanel>
            <left>
                <TextField fx:id="contactsSearchField"
                    promptText="Search contacts…" />
            </left>
        </FilterPanel>
    </top>

    <center>
        <ScrollableListRegion fx:id="contactsListRegion">
            <content>
                <FlowPane fx:id="contactsFlow" hgap="16" vgap="16"
                    prefWrapLength="1040" styleClass="cases-content-surface glass-panel">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                </FlowPane>
            </content>
            <emptyLabel>
                <Label fx:id="contactsEmptyStateLabel"
                    text="No contacts to display yet." styleClass="shale-empty-state"
                    visible="false" managed="false" />
            </emptyLabel>
            <loadingLabel>
                <Label fx:id="contactsLoadingStateLabel"
                    text="Loading contacts…" styleClass="shale-loading-placeholder"
                    visible="false" managed="false" />
            </loadingLabel>
        </ScrollableListRegion>
    </center>

</BorderPane>
