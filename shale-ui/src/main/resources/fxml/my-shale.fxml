<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.MyShaleController"
	styleClass="app-shell, shell-route-page, my-shale-page">
	<center>
		<VBox spacing="12" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
			<padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

			<VBox spacing="4" styleClass="my-shale-page-header">
				<Label text="My Shale" styleClass="shale-page-title" />
				<Label text="Overview of your tasks, assigned cases, and recent activity."
					wrapText="true" styleClass="shale-metadata-muted" />
			</VBox>

			<ScrollPane minHeight="-Infinity" prefViewportHeight="42" fitToHeight="true" fitToWidth="false"
				hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" pannable="true" styleClass="app-section-tabs-scroll">
				<HBox fx:id="sectionTabsBar" spacing="8" alignment="CENTER_LEFT" styleClass="app-section-tabs-row" />
			</ScrollPane>

			<StackPane fx:id="sectionContentStack" maxWidth="1.7976931348623157E308"
				maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS">
				<VBox fx:id="overviewSectionPane" spacing="10" maxWidth="1.7976931348623157E308"
					maxHeight="1.7976931348623157E308">
					<Label fx:id="overviewLoadingLabel" text="Loading your overview…" managed="false" visible="false"
						styleClass="shale-loading-placeholder" />
					<ScrollPane fx:id="overviewScroll" fitToWidth="true" pannable="true" hbarPolicy="NEVER"
						vbarPolicy="AS_NEEDED" styleClass="surface-scroll, my-shale-page-scroll" VBox.vgrow="ALWAYS">
						<content><VBox fx:id="overviewMainRow" spacing="12" fillWidth="true" /></content>
					</ScrollPane>
				</VBox>

				<VBox fx:id="tasksSectionPane" spacing="10" visible="false" managed="false"
					maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
					<VBox fx:id="tasksSectionContentHost" VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308"
						maxHeight="1.7976931348623157E308">
						<VBox fx:id="myTasksPanel" spacing="12" styleClass="shale-section-card, my-shale-section"
							VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
							<HBox spacing="8" alignment="CENTER_LEFT">
								<Label text="My Tasks" styleClass="shale-section-title" />
								<Label fx:id="myTasksResultCount" text="0 results" styleClass="my-shale-results-count" />
								<Region HBox.hgrow="ALWAYS" />
								<HBox spacing="0" alignment="CENTER_RIGHT" styleClass="my-tasks-view-toggle-group, shale-segmented-control">
									<Button fx:id="myTasksBoardViewButton" text="Board" styleClass="my-tasks-view-toggle, shale-segment" />
									<Button fx:id="myTasksGridViewButton" text="Grid" styleClass="my-tasks-view-toggle, shale-segment" />
								</HBox>
							</HBox>
							<FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="shale-toolbar, my-shale-toolbar">
								<Label text="Task View" styleClass="shale-field-label" />
								<ChoiceBox fx:id="myTasksSourceChoice" prefWidth="170" />
								<ChoiceBox fx:id="myTasksSortChoice" prefWidth="170" />
								<Button fx:id="myTasksShowCompletedButton" text="Show Completed" />
								<ChoiceBox fx:id="myTasksStatusFilterChoice" prefWidth="150" />
								<ChoiceBox fx:id="myTasksPriorityFilterChoice" prefWidth="190" />
								<Label text="Cases" styleClass="shale-field-label" />
								<ChoiceBox fx:id="myTasksCaseFilterChoice" prefWidth="180" />
								<ChoiceBox fx:id="myTasksColumnOrderChoice" prefWidth="220" />
							</FlowPane>
							<FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="my-shale-search-row">
								<TextField fx:id="myTasksSearchField" promptText="Search my tasks…" prefWidth="320" />
								<Button fx:id="myTasksClearAllFiltersButton" text="Clear all filters" onAction="#clearAllMyTasksFilters" />
							</FlowPane>
							<Label fx:id="myTasksLoadingLabel" text="Loading your tasks…" managed="false" visible="false" styleClass="shale-loading-placeholder" />
							<Label fx:id="myTasksErrorLabel" text="Unable to load your tasks." managed="false" visible="false" styleClass="shale-error-state" />
							<Label fx:id="myTasksEmptyLabel" text="No tasks assigned to you." managed="false" visible="false" styleClass="shale-empty-state" />
							<ScrollPane fx:id="myTasksScroll" fitToHeight="true" pannable="true" hbarPolicy="AS_NEEDED"
								vbarPolicy="NEVER" styleClass="surface-scroll, my-shale-bounded-list" VBox.vgrow="ALWAYS">
								<content><HBox fx:id="myTasksList" spacing="10" styleClass="cases-content-surface, my-shale-board-content" /></content>
							</ScrollPane>
						</VBox>
					</VBox>
				</VBox>

				<VBox fx:id="myCasesSectionPane" spacing="10" visible="false" managed="false"
					maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
					<VBox fx:id="myCasesSectionContentHost" VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308"
						maxHeight="1.7976931348623157E308">
						<VBox spacing="12" styleClass="shale-section-card, my-shale-section" VBox.vgrow="ALWAYS"
							maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308">
							<HBox spacing="8" alignment="CENTER_LEFT">
								<Label text="My Cases" styleClass="shale-section-title" />
								<Label fx:id="myCasesResultCount" text="0 results" styleClass="my-shale-results-count" />
							</HBox>
							<FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="shale-toolbar, my-shale-toolbar">
								<TextField fx:id="myCasesBoardSearchField" promptText="Search case name or case number…" prefWidth="320" />
								<ChoiceBox fx:id="myCasesBoardStatusFilterChoice" prefWidth="200" />
								<ChoiceBox fx:id="myCasesBoardSortChoice" prefWidth="220" />
								<Button fx:id="myCasesClearAllFiltersButton" text="Clear all filters" onAction="#clearAllMyCasesFilters" />
							</FlowPane>
							<Label fx:id="myCasesLoadingLabel" text="Loading your cases…" managed="false" visible="false" styleClass="shale-loading-placeholder" />
							<Label fx:id="myCasesErrorLabel" text="Unable to load assigned cases." managed="false" visible="false" styleClass="shale-error-state" />
							<Label fx:id="myCasesBoardEmptyLabel" text="No cases assigned to you." managed="false" visible="false" styleClass="shale-empty-state" />
							<ScrollPane fx:id="myCasesBoardScroll" fitToHeight="true" pannable="true" hbarPolicy="AS_NEEDED"
								vbarPolicy="NEVER" styleClass="surface-scroll, my-shale-bounded-list" VBox.vgrow="ALWAYS">
								<content><HBox fx:id="myCasesBoardList" spacing="10" styleClass="cases-content-surface, my-shale-board-content" /></content>
							</ScrollPane>
						</VBox>
					</VBox>
				</VBox>
			</StackPane>
		</VBox>
	</center>
</BorderPane>
