<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import com.shale.ui.component.FilterPanel?>
<?import com.shale.ui.component.ScrollableListRegion?>

<BorderPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.shale.ui.controller.TeamController" styleClass="app-shell">

	<top>
		<FilterPanel>
			<left>
				<TextField fx:id="teamSearchField"
					promptText="Search team members…" />
			</left>
		</FilterPanel>
	</top>

	<center>
		<ScrollableListRegion fx:id="teamListRegion">
			<content>
				<FlowPane fx:id="teamFlow" hgap="14" vgap="14"
					prefWrapLength="1040" styleClass="cases-content-surface glass-panel data-surface">
					<padding>
						<Insets top="14" right="14" bottom="14" left="14" />
					</padding>
				</FlowPane>
			</content>
			<emptyLabel>
				<Label fx:id="teamEmptyStateLabel"
					text="No team members to display yet." styleClass="shale-empty-state"
					visible="false" managed="false" />
			</emptyLabel>
		</ScrollableListRegion>
	</center>

</BorderPane>
