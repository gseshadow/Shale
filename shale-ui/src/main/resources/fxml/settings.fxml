<?xml version="1.0" encoding="UTF-8"?>
<?import com.shale.ui.component.SettingsManagementRow?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shale.ui.controller.SettingsController" fitToWidth="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="surface-scroll, settings-scroll">
  <content>
    <VBox styleClass="settings-workspace">
      <fx:define><ToggleGroup fx:id="appearanceThemeGroup"/></fx:define>
      <VBox fx:id="personalGroup" styleClass="settings-directory-group, shale-section-card">
        <Label text="Personal" styleClass="shale-subsection-title, settings-group-title"/>
        <SettingsManagementRow fx:id="appearanceRow" title="Appearance"
            description="Choose Shale’s color theme." actionText="Open"/>
        <VBox fx:id="appearanceContent" visible="false" managed="false" styleClass="settings-inline-content">
          <Label text="Color theme" styleClass="app-dialog-field-label"/>
          <HBox styleClass="settings-appearance-selector">
            <ToggleButton fx:id="lightThemeButton" text="Light" toggleGroup="$appearanceThemeGroup" onAction="#onAppearanceSelected" accessibleText="Use Light color theme"/>
            <ToggleButton fx:id="darkThemeButton" text="Dark" toggleGroup="$appearanceThemeGroup" onAction="#onAppearanceSelected" accessibleText="Use Dark color theme"/>
          </HBox>
          <Label fx:id="appearanceStatusLabel" styleClass="settings-state-message" wrapText="true"/>
        </VBox>
        <SettingsManagementRow fx:id="notificationPreferencesRow" title="Notification Preferences"
            description="Choose generated notifications and banner behavior." actionText="Open"/>
        <VBox fx:id="notificationPreferencesContent" visible="false" managed="false" styleClass="settings-inline-content">
          <Label text="Categories" styleClass="app-dialog-field-label"/>
          <FlowPane hgap="16" vgap="8">
            <CheckBox fx:id="taskAssignedToMeCheck" text="Task assigned to me"/><CheckBox fx:id="taskOverdueCheck" text="Task overdue"/>
            <CheckBox fx:id="taskDueTodayCheck" text="Task due today"/><CheckBox fx:id="taskDueTomorrowCheck" text="Task due tomorrow"/>
            <CheckBox fx:id="appUpdatesCheck" text="App updates"/><CheckBox fx:id="connectivityCheck" text="Connectivity"/>
          </FlowPane>
          <Label text="Banner behavior" styleClass="app-dialog-field-label"/>
          <FlowPane hgap="16" vgap="8">
            <CheckBox fx:id="taskOverdueBannerCheck" text="Task overdue banner"/><CheckBox fx:id="taskDueTodayBannerCheck" text="Task due today banner"/>
            <CheckBox fx:id="appUpdatesBannerCheck" text="App updates banner"/><CheckBox fx:id="connectivityBannerCheck" text="Connectivity banner"/>
          </FlowPane>
          <HBox styleClass="settings-inline-actions"><Button fx:id="applyNotificationPreferencesButton" text="Apply" onAction="#onApplyNotificationPreferences"/><Button fx:id="resetNotificationPreferencesButton" text="Reset" onAction="#onResetNotificationPreferences"/><Label fx:id="notificationSettingsStatusLabel" styleClass="settings-state-message" wrapText="true" HBox.hgrow="ALWAYS"/></HBox>
        </VBox>
        <SettingsManagementRow fx:id="customDictionaryRow" title="Custom Dictionary"
            description="Manage words accepted by Shale’s spelling tools." actionText="Manage"/>
      </VBox>

      <VBox fx:id="caseConfigurationGroup" styleClass="settings-directory-group, shale-section-card">
        <Label text="Case Configuration" styleClass="shale-subsection-title, settings-group-title"/>
        <SettingsManagementRow fx:id="caseStatusesRow" title="Case Statuses" description="Manage case statuses, colors, workflow state, and order."/>
        <SettingsManagementRow fx:id="practiceAreasRow" title="Practice Areas" description="Manage practice-area names, colors, and availability."/>
        <SettingsManagementRow fx:id="linkTypesRow" title="Link Types" description="Manage case-link types, colors, and availability."/>
        <SettingsManagementRow fx:id="caseTeamRolesRow" title="Case Team Roles" description="Manage team roles, colors, and availability."/>
        <SettingsManagementRow fx:id="caseDatesRow" title="Case Dates" description="Manage date types and their presentation."/>
        <SettingsManagementRow fx:id="caseDateMappingsRow" title="Protected Case Date Mappings" description="Associate required semantic roles with eligible Case Date types." actionText="Open"/>
        <VBox fx:id="caseDateRoleMappingsContent" visible="false" managed="false" styleClass="settings-inline-content">
          <Label text="Protected semantic-role mappings" styleClass="app-dialog-field-label"/>
          <Label text="Mappings remain separate from definition records and use the authoritative Case Date mapping service." styleClass="search-summary-text" wrapText="true"/>
          <VBox fx:id="caseDateRoleMappingsContainer" spacing="8" styleClass="shale-density-card-compact"/>
          <Label fx:id="caseDateMappingStatusLabel" styleClass="settings-state-message" wrapText="true"/>
        </VBox>
      </VBox>

      <VBox fx:id="requestConfigurationGroup" styleClass="settings-directory-group, shale-section-card">
        <Label text="Request Configuration" styleClass="shale-subsection-title, settings-group-title"/>
        <SettingsManagementRow fx:id="requestFieldsRow" title="Request Fields" description="Manage material types, request methods, and request statuses."/>
      </VBox>

      <VBox fx:id="contactOrganizationConfigurationGroup" styleClass="settings-directory-group, shale-section-card">
        <Label text="Contact and Organization Configuration" styleClass="shale-subsection-title, settings-group-title"/>
        <SettingsManagementRow fx:id="contactClassificationsRow" title="Contact Classifications" description="Manage contact types, specialties, and credentials."/>
        <SettingsManagementRow fx:id="organizationTypesRow" title="Organization Types" description="Manage organization types, colors, and availability."/>
      </VBox>

      <VBox fx:id="administrationGroup" styleClass="settings-directory-group, shale-section-card">
        <Label text="Administration" styleClass="shale-subsection-title, settings-group-title"/>
        <SettingsManagementRow fx:id="userManagementRow" title="User Management" description="Manage users for the current tenant." actionText="Manage"/>
        <SettingsManagementRow fx:id="auditLogRow" title="Audit Log" description="Review PHI audit and entity activity for the current tenant." actionText="Open"/>
      </VBox>
    </VBox>
  </content>
</ScrollPane>
