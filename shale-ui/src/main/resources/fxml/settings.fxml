<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shale.ui.controller.SettingsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="surface-scroll">
    <content>
        <VBox spacing="14" styleClass="cases-content-surface glass-panel">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label text="Notifications" styleClass="search-section-title"/>
            <Label text="Control which notifications are generated and when they appear as banners."
                   styleClass="search-summary-text" wrapText="true"/>

            <VBox spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Categories" styleClass="app-dialog-field-label"/>
                <CheckBox fx:id="taskAssignedToMeCheck" text="Task assigned to me"/>
                <CheckBox fx:id="taskOverdueCheck" text="Task overdue"/>
                <CheckBox fx:id="taskDueTodayCheck" text="Task due today"/>
                <CheckBox fx:id="taskDueTomorrowCheck" text="Task due tomorrow"/>
                <CheckBox fx:id="appUpdatesCheck" text="App updates"/>
                <CheckBox fx:id="connectivityCheck" text="Connectivity"/>
            </VBox>

            <VBox spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Banner behavior" styleClass="app-dialog-field-label"/>
                <CheckBox fx:id="taskOverdueBannerCheck" text="Task overdue banner"/>
                <CheckBox fx:id="taskDueTodayBannerCheck" text="Task due today banner"/>
                <CheckBox fx:id="appUpdatesBannerCheck" text="App updates banner"/>
                <CheckBox fx:id="connectivityBannerCheck" text="Connectivity banner"/>
            </VBox>

            <Separator/>

            <HBox spacing="10">
                <Button text="Apply" onAction="#onApplyNotificationPreferences" styleClass="app-toolbar-button app-toolbar-button-primary app-toolbar-button-compact"/>
                <Button text="Reset" onAction="#onResetNotificationPreferences" styleClass="app-toolbar-button app-toolbar-button-neutral app-toolbar-button-compact"/>
                <Label fx:id="notificationSettingsStatusLabel" styleClass="search-summary-text" wrapText="true">
                    <HBox.margin>
                        <Insets left="8"/>
                    </HBox.margin>
                </Label>
            </HBox>

            <Separator/>

            <VBox fx:id="caseStatusAdministrationSection" spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Case Statuses" styleClass="search-section-title"/>
                <Label text="Manage the case statuses available for this tenant."
                       styleClass="search-summary-text" wrapText="true"/>
                <VBox fx:id="caseStatusCardsContainer" spacing="8" styleClass="shale-density-card-compact"/>
                <HBox fx:id="caseStatusActionRow" spacing="8">
                    <Label fx:id="caseStatusSettingsStatusLabel" styleClass="search-summary-text" wrapText="true"/>
                </HBox>
            </VBox>


            <VBox fx:id="practiceAreaAdministrationSection" spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Practice Areas" styleClass="search-section-title"/>
                <Label text="Manage the practice areas available for this tenant."
                       styleClass="search-summary-text" wrapText="true"/>
                <VBox fx:id="practiceAreaCardsContainer" spacing="8" styleClass="shale-density-card-compact"/>
                <HBox fx:id="practiceAreaActionRow" spacing="8">
                    <Label fx:id="practiceAreaSettingsStatusLabel" styleClass="search-summary-text" wrapText="true"/>
                </HBox>
            </VBox>


            <VBox fx:id="userAdministrationSection" spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="User Management" styleClass="search-section-title"/>
                <Label text="Manage users for the current tenant. Tenant id is applied from your signed-in session."
                       styleClass="search-summary-text" wrapText="true"/>
                <CheckBox fx:id="showInactiveUsersCheck" text="Show inactive users" onAction="#onToggleInactiveUsers"/>
                <TableView fx:id="userManagementTable" prefHeight="260" styleClass="shale-table">
                    <columns>
                        <TableColumn fx:id="userNameColumn" text="Name" prefWidth="180"/>
                        <TableColumn fx:id="userEmailColumn" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="userInitialsColumn" text="Initials" prefWidth="80"/>
                        <TableColumn fx:id="userAttorneyColumn" text="Attorney" prefWidth="90"/>
                        <TableColumn fx:id="userAdminColumn" text="Admin" prefWidth="80"/>
                        <TableColumn fx:id="userStatusColumn" text="Status" prefWidth="100"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button text="Add User" onAction="#onAddUser" styleClass="app-toolbar-button app-toolbar-button-primary app-toolbar-button-compact"/>
                    <Button fx:id="deactivateUserButton" text="Deactivate User" onAction="#onDeactivateUser" styleClass="app-toolbar-button app-toolbar-button-danger app-toolbar-button-compact" disable="true"/>
                    <Button fx:id="reactivateUserButton" text="Reactivate User" onAction="#onReactivateUser" styleClass="app-toolbar-button app-toolbar-button-neutral app-toolbar-button-compact" disable="true"/>
                    <Button fx:id="resetPasswordButton" text="Reset Password" onAction="#onResetUserPassword" styleClass="app-toolbar-button app-toolbar-button-neutral app-toolbar-button-compact" disable="true"/>
                    <Label fx:id="userManagementStatusLabel" styleClass="search-summary-text" wrapText="true"/>
                </HBox>
            </VBox>


            <VBox fx:id="auditSection" spacing="8" styleClass="strong-panel">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="Audit" styleClass="app-dialog-field-label"/>
                <Button fx:id="viewAuditLogButton"
                        text="View Audit Log"
                        styleClass="app-toolbar-button app-toolbar-button-neutral app-toolbar-button-compact"
                        onAction="#onViewAuditLog"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
