<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.shale.ui.component.EnhancedTextArea?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.shale.ui.controller.NewIntakeController"
            prefWidth="1160" prefHeight="900" minWidth="680" minHeight="620"
            styleClass="form-surface new-intake-root">
    <top>
        <Label fx:id="validationLabel" wrapText="true" visible="false" managed="false"
               accessibleRole="TEXT" styleClass="new-intake-feedback shale-error-message" />
    </top>
    <center>
        <ScrollPane fx:id="intakeScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    BorderPane.alignment="CENTER" styleClass="new-intake-scroll">
            <content>
                <GridPane fx:id="intakeWorkspace" hgap="16" vgap="16" maxWidth="1.7976931348623157E308"
                          styleClass="new-intake-workspace">
                    <columnConstraints>
                        <ColumnConstraints fx:id="leftWorkspaceColumn" percentWidth="45" hgrow="ALWAYS" fillWidth="true" />
                        <ColumnConstraints fx:id="rightWorkspaceColumn" percentWidth="55" hgrow="ALWAYS" fillWidth="true" />
                    </columnConstraints>
                    <children>
                        <VBox fx:id="callerSection" spacing="12" maxWidth="1.7976931348623157E308"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"
                              styleClass="shale-section-card new-intake-section caller-section-panel">
                            <Label text="Caller" styleClass="shale-section-title" />
                            <Label fx:id="callerReuseLabel" text="Client information will be reused for caller details."
                                   visible="false" managed="false" wrapText="true" styleClass="shale-metadata-muted" />
                            <GridPane fx:id="callerFieldsGrid" hgap="12" vgap="10" maxWidth="1.7976931348623157E308" styleClass="new-intake-fields-grid">
                                <columnConstraints><ColumnConstraints minWidth="120" prefWidth="145"/><ColumnConstraints minWidth="160" hgrow="ALWAYS" fillWidth="true"/></columnConstraints>
                                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="First Name" styleClass="shale-field-label"/><Label fx:id="callerFirstNameRequiredIndicator" text="*" accessibleText="required" styleClass="new-intake-required"/></HBox>
                                <TextField fx:id="callerFirstNameField" accessibleText="Caller first name, required" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="1"><Label text="Last Name" styleClass="shale-field-label"/><Label fx:id="callerLastNameRequiredIndicator" text="*" accessibleText="required" styleClass="new-intake-required"/></HBox>
                                <TextField fx:id="callerLastNameField" accessibleText="Caller last name, required" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="2"><Label text="Phone Number" styleClass="shale-field-label"/><Label fx:id="callerPhoneRequiredIndicator" text="*" accessibleText="required" styleClass="new-intake-required"/></HBox>
                                <TextField fx:id="callerPhoneField" accessibleText="Caller phone number, required" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Address" styleClass="shale-field-label" GridPane.rowIndex="3"/><TextField fx:id="callerAddressField" accessibleText="Caller address" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Email" styleClass="shale-field-label" GridPane.rowIndex="4"/><TextField fx:id="callerEmailField" accessibleText="Caller email" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                            </GridPane>
                        </VBox>

                        <VBox fx:id="clientSection" spacing="12" maxWidth="1.7976931348623157E308"
                              GridPane.columnIndex="0" GridPane.rowIndex="1"
                              styleClass="shale-section-card new-intake-section client-section-panel">
                            <Label text="Client" styleClass="shale-section-title"/>
                            <CheckBox fx:id="callerIsClientCheckBox" text="Caller is Client" accessibleText="Caller is Client"/>
                            <GridPane hgap="12" vgap="10" maxWidth="1.7976931348623157E308" styleClass="new-intake-fields-grid">
                                <columnConstraints><ColumnConstraints minWidth="120" prefWidth="145"/><ColumnConstraints minWidth="160" hgrow="ALWAYS" fillWidth="true"/></columnConstraints>
                                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="First Name" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox><TextField fx:id="clientFirstNameField" accessibleText="Client first name, required" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="1"><Label text="Last Name" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox><TextField fx:id="clientLastNameField" accessibleText="Client last name, required" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Address" styleClass="shale-field-label" GridPane.rowIndex="2"/><TextField fx:id="clientAddressField" accessibleText="Client address" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="3"><Label text="Phone Number" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox><TextField fx:id="clientPhoneField" accessibleText="Client phone number, required" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Email" styleClass="shale-field-label" GridPane.rowIndex="4"/><TextField fx:id="clientEmailField" accessibleText="Client email" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Date of Birth" styleClass="shale-field-label" GridPane.rowIndex="5"/><DatePicker fx:id="clientDateOfBirthPicker" accessibleText="Client date of birth" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Deceased" styleClass="shale-field-label" GridPane.rowIndex="6"/><CheckBox fx:id="clientDeceasedCheckBox" accessibleText="Client deceased" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                                <Label text="Client Condition" styleClass="shale-field-label" GridPane.rowIndex="7"/><EnhancedTextArea fx:id="clientConditionArea" accessibleText="Client condition" editorTitle="Client Condition" prefRowCount="3" promptText="Relevant medical condition or client circumstances" GridPane.rowIndex="7" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                            </GridPane>
                        </VBox>

                        <VBox fx:id="caseSection" spacing="12" maxWidth="1.7976931348623157E308"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"
                              styleClass="shale-section-card new-intake-section case-section-panel">
                            <Label text="Case" styleClass="shale-section-title"/>
                            <GridPane hgap="12" vgap="10" maxWidth="1.7976931348623157E308" styleClass="new-intake-fields-grid">
                                <columnConstraints><ColumnConstraints minWidth="140" prefWidth="160"/><ColumnConstraints minWidth="180" hgrow="ALWAYS" fillWidth="true"/></columnConstraints>
                                <HBox spacing="4" alignment="CENTER_LEFT"><Label text="Case Name" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox><TextField fx:id="caseNameField" accessibleText="Case name, required" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="1"><Label text="Time of Intake" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox><TextField fx:id="timeOfIntakeField" accessibleText="Time of intake, required" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                <Label text="Estate Case" styleClass="shale-field-label" GridPane.rowIndex="2"/><CheckBox fx:id="estateCaseCheckBox" accessibleText="Estate case" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="3"><Label text="Practice Area" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"><StackPane fx:id="practiceAreaHost" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/><Button fx:id="selectPracticeAreaButton" text="Change" accessibleText="Change practice area"/></HBox>
                                <HBox spacing="4" alignment="CENTER_LEFT" GridPane.rowIndex="4"><Label text="Status" styleClass="shale-field-label"/><Label text="*" accessibleText="required" styleClass="new-intake-required"/></HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"><StackPane fx:id="statusHost" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/><Button fx:id="selectStatusButton" text="Change" accessibleText="Change case status"/></HBox>
                            </GridPane>
                        </VBox>

                        <VBox fx:id="partiesSection" spacing="12" maxWidth="1.7976931348623157E308"
                              maxHeight="-Infinity" GridPane.valignment="TOP"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"
                              styleClass="shale-section-card new-intake-section new-intake-parties-section">
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Parties" styleClass="shale-section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="addPartyButton" text="Add Party" accessibleText="Add a pending case party"/></HBox>
                            <Label fx:id="partiesEmptyLabel" text="No pending parties yet." wrapText="true" styleClass="shale-empty-message"/>
                            <VBox fx:id="partiesListBox" spacing="8" maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox fx:id="incidentSection" spacing="12" maxWidth="1.7976931348623157E308"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"
                              styleClass="shale-section-card new-intake-section incident-section-panel">
                            <Label text="Incident" styleClass="shale-section-title"/>
                            <Label text="Description" styleClass="shale-field-label"/><EnhancedTextArea fx:id="descriptionArea" accessibleText="Incident description" editorTitle="Description" prefRowCount="4" promptText="Detailed description of the matter" maxWidth="1.7976931348623157E308"/>
                            <Label text="Summary" styleClass="shale-field-label"/><EnhancedTextArea fx:id="summaryArea" accessibleText="Incident summary" editorTitle="Summary" prefRowCount="4" promptText="Concise intake summary" maxWidth="1.7976931348623157E308"/>
                            <VBox fx:id="datesSection" spacing="10" maxWidth="1.7976931348623157E308" styleClass="new-intake-dates-section">
                                <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Dates" styleClass="shale-subsection-title"/><Region HBox.hgrow="ALWAYS"/><HBox fx:id="datesAdminActions" spacing="8"/></HBox>
                                <Label fx:id="datesStatusLabel" text="Loading date fields…" wrapText="true" styleClass="shale-metadata-muted"/>
                                <GridPane fx:id="legacyDatesGrid" visible="false" managed="false" hgap="12" vgap="10" maxWidth="1.7976931348623157E308" styleClass="new-intake-fields-grid">
                                    <columnConstraints><ColumnConstraints minWidth="180" prefWidth="220"/><ColumnConstraints minWidth="160" hgrow="ALWAYS" fillWidth="true"/></columnConstraints>
                                    <Label text="Date of Medical Negligence" wrapText="true" styleClass="shale-field-label"/><DatePicker fx:id="dateMedicalNegligencePicker" accessibleText="Date of medical negligence" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                    <Label text="Date Medical Negligence Was Discovered" wrapText="true" styleClass="shale-field-label" GridPane.rowIndex="1"/><DatePicker fx:id="dateMedicalNegligenceDiscoveredPicker" accessibleText="Date medical negligence was discovered" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                    <Label text="Date of Injury" styleClass="shale-field-label" GridPane.rowIndex="2"/><DatePicker fx:id="dateOfInjuryPicker" accessibleText="Date of injury" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                    <Label text="Statute of Limitations" wrapText="true" styleClass="shale-field-label" GridPane.rowIndex="3"/><DatePicker fx:id="statuteOfLimitationsPicker" accessibleText="Statute of limitations" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                    <Label text="Tort Claims Notice" styleClass="shale-field-label" GridPane.rowIndex="4"/><DatePicker fx:id="tortClaimsNoticePicker" accessibleText="Tort claims notice" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="1.7976931348623157E308"/>
                                </GridPane>
                                <VBox fx:id="configuredDatesBox" spacing="10" visible="false" managed="false"/>
                                <VBox fx:id="datesCustomizationBox" spacing="10" visible="false" managed="false"/>
                            </VBox>
                        </VBox>
                    </children>
                </GridPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox fx:id="intakeActionBar" spacing="10" alignment="CENTER_RIGHT" styleClass="new-intake-action-bar">
            <Button fx:id="cancelButton" text="Cancel" cancelButton="true" onAction="#onCancel" accessibleText="Cancel New Intake"/>
            <Button fx:id="createIntakeButton" text="Create Intake" onAction="#onCreateIntake" accessibleText="Create Intake"/>
        </HBox>
    </bottom>
</BorderPane>
