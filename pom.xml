<!-- shale-parent/pom.xml -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shale</groupId>
    <artifactId>shale-parent</artifactId>
    <version>1.0.138</version>
    <packaging>pom</packaging>

    <name>Shale</name>
    <description>Parent POM for the Shale application</description>

    <properties>
        <!-- Java / build -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- One supported Spring generation across server and shared crypto consumers. -->
        <spring.boot.version>4.1.1</spring.boot.version>

        <!-- Library versions -->
        <javafx.version>21.0.4</javafx.version>
        <mssql.jdbc.version>12.6.1.jre11</mssql.jdbc.version>
        <hikari.version>5.1.0</hikari.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <gson.version>2.11.0</gson.version>
        <richtextfx.version>0.11.6</richtextfx.version>
        <jna.version>5.15.0</jna.version>

        <!-- Plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <surefire.version>3.5.6</surefire.version>
        <failsafe.version>3.5.6</failsafe.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <maven.dependency.plugin.version>3.6.1</maven.dependency.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>

        <!-- Defaults forwarded by javafx-maven-plugin for local developer runs. -->
        <shale.profile></shale.profile>
        <!-- Routine builds execute only the release-blocking critical inventory. -->
        <shale.test.includesFile>${maven.multiModuleProjectDirectory}/build/test-selection/critical-tests.txt</shale.test.includesFile>
        <shale.test.excludesFile>${maven.multiModuleProjectDirectory}/build/test-selection/ui-visual-advisory-tests.txt</shale.test.excludesFile>
    </properties>

    <modules>
        <module>shale-core</module>
        <module>shale-data</module>
        <module>shale-ui</module>
        <module>shale-desktop</module>
        <module>shale-updater</module>
        <module>shale-server</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>org.fxmisc.richtext</groupId>
                <artifactId>richtextfx</artifactId>
                <version>${richtextfx.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shale</groupId>
                <artifactId>shale-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shale</groupId>
                <artifactId>shale-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shale</groupId>
                <artifactId>shale-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shale</groupId>
                <artifactId>shale-desktop</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shale</groupId>
                <artifactId>shale-updater</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Deliberate compatibility exceptions to the Boot BOM: retain Shale's JDBC
                 driver/pool lifecycle and the desktop's independent Gson wire contracts. -->
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${mssql.jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikari.version}</version>
            </dependency>

            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mindrot</groupId>
                <artifactId>jbcrypt</artifactId>
                <version>${jbcrypt.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna-platform</artifactId><version>${jna.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Resource filtering -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
                    </configuration>
                </plugin>

                <!-- Java compiler -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <!-- Tests -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                </plugin>

                <!-- JavaFX plugin -->
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>${javafx.maven.plugin.version}</version>
                </plugin>

                <!-- Dependency plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includesFile>${shale.test.includesFile}</includesFile>
                    <excludesFile>${shale.test.excludesFile}</excludesFile>
                    <failIfNoTests>false</failIfNoTests>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>all-tests</id>
            <properties>
                <shale.test.includesFile>${maven.multiModuleProjectDirectory}/build/test-selection/all-tests.txt</shale.test.includesFile>
                <shale.test.excludesFile>${maven.multiModuleProjectDirectory}/build/test-selection/no-excluded-tests.txt</shale.test.excludesFile>
            </properties>
        </profile>
        <profile>
            <id>ui-visual</id>
            <properties>
                <shale.test.includesFile>${maven.multiModuleProjectDirectory}/build/test-selection/ui-visual-advisory-tests.txt</shale.test.includesFile>
                <shale.test.excludesFile>${maven.multiModuleProjectDirectory}/build/test-selection/no-excluded-tests.txt</shale.test.excludesFile>
            </properties>
        </profile>
    </profiles>
</project>
