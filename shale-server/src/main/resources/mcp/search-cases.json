{
  "name": "search_cases",
  "description": "Find active Cases by a literal Case-name substring in your authorized Shale tenant. Use at least three letters or digits. Returns at most ten minimized summaries per page, pages 0 through 9. No blank browse or export. If windowExhausted is true, stop and narrow the query; do not request another page. No documents, narratives or Case Dates are returned.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "page": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "default": 0
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items",
      "page",
      "size",
      "hasMore",
      "windowExhausted",
      "correlationId"
    ],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "$ref": "#/$defs/Case"
        }
      },
      "page": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "size": {
        "const": 10
      },
      "hasMore": {
        "type": "boolean"
      },
      "windowExhausted": {
        "type": "boolean"
      },
      "correlationId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "$defs": {
      "Case": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "caseNumber",
          "caseName",
          "status",
          "practiceArea",
          "responsibleAttorney",
          "primaryLegalAssistant",
          "updatedAt"
        ],
        "properties": {
          "caseId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "caseNumber": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "caseName": {
            "type": "string",
            "maxLength": 255
          },
          "status": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "color"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "color": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^#[0-9a-fA-F]{6}$",
                "maxLength": 7
              }
            }
          },
          "practiceArea": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string",
                "maxLength": 255
              }
            }
          },
          "responsibleAttorney": {
            "$ref": "#/$defs/CaseUser"
          },
          "primaryLegalAssistant": {
            "$ref": "#/$defs/CaseUser"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 16,
            "maxLength": 29,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?$"
          }
        }
      },
      "CaseUser": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "userId",
          "displayName"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "displayName": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    }
  }
}
